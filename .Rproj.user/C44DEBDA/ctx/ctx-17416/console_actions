        "results_tmp2$mse_ratio2_ham <- results_tmp2$mse_ham/results_tmp2$mse_combined",
        "> ",
        "> ",
        "### Write the generated results to RDS #######",
        "> ",
        "if(home_comp_flag==F){",
        "+ ",
        "saveRDS(results_tmp2,",
        "+ ",
        "        file = paste0(dir,",
        "+ ",
        "                      \"/simulation_data/sim0/results_\",",
