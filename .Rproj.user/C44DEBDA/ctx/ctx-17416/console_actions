        "  t(out$beta_hat_rl - beta_1) %*% (out$beta_hat_rl - beta_1) )",
        "+ ",
        "+ ",
        "+ ",
        "# (7) RL aCI:",
        "+ ",
        "rl_aCI_out <- rl_aCI(lambda = out$lambda_rl,",
        "+ ",
        "                     scaled_XTX = scaled_XTMX_est,",
        "+ ",
        "                     indv_mle = beta1_mle,",
        "+ ",
        "                     p = 1, D = D,",
        "+ ",
        "                     alpha = .05)",
