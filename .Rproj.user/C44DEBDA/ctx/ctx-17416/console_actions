        "  out$theta_hat_kwon <- c(kwon$mu_opt[,1])",
        "+ ",
        "  out$kwon_lambda <- kwon$Lambda_opt",
        "+ ",
        "  # (6) Preserve sq error",
        "+ ",
        "  out$sqerr_kwon <- as.numeric(",
        "+ ",
        "    t(out$beta_hat_kwon - beta) %*% (out$beta_hat_kwon - beta))",
        "+ ",
        "} else {",
        "+ ",
        "  out$beta_hat_kwon <- NaN",
        "+ ",
        "  out$theta_hat_kwon <- NaN",
        "+ ",
        "  out$kwon_lambda <- NaN",
        "+ ",
        "  out$sqerr_kwon <- NaN",
        "+ ",
        "}",
        "+ ",
