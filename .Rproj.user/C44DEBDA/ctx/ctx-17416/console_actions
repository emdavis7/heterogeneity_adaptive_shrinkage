        "indv_mle_mat <- matrix(data$indv_mle, nrow = p, ncol = D)",
        "+ ",
        "# M: list of D variance matrices.",
        "+ ",
        "M <- lapply(1:D, function(l){solve(data$scaled_XTX_est_list[[l]])})",
